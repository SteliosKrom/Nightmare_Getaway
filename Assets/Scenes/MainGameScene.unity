  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "If you\u2019re reading this, then you\u2019ve been dragged into this place
    the same way I was. I can\u2019t explain it\u2014one moment I was outside, and
    the next I woke up inside this house with the door locked behind me.\n\nThings
    haven\u2019t been the same since that night. The whispers were the first sign\u2026
    soft, distant, like voices slipping through the cracks in the walls. Then the
    radio started acting on its own. The dolls, too\u2014never where I remember leaving
    them.\n\nI keep seeing shapes in the bedrooms after dark. Not people. Not shadows
    either. Something else.\n\nI\u2019ve tried to map out the rooms, tried to understand
    this place, but the longer I\u2019m here, the more it feels alive. Not haunted\u2014occupied.\n\nIf
    you\u2019ve found this note, I hope you\u2019re not here for long.\n\n\u2014
    A. Morgan"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
